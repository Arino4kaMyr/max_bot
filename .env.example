# Токен чат-бота MAX. Выдаётся организаторами / @MasterBot.
BOT_TOKEN=

# Подключение к PostgreSQL
DATABASE_URL=postgres://app:app@db:5432/accessible

# Город пилота (slug KudaGo): kzn | msk | spb | ekb | nnv
CITY_SLUG=kzn

# Часовой пояс города (для подбора "на выходных" и проактивных сообщений)
CITY_TZ=Europe/Moscow

# Периодичность синхронизации афиши, cron
SYNC_CRON=0 * * * *

# Проактивная рассылка: четверг 12:00
DIGEST_CRON=0 12 * * 4
